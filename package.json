{
  "name": "starrupture-planner",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "type": "module",
  "description": "A website that allows you to create a detailed production workflow for the video game StarRupture.",
  "homepage": "https://starruptureplanner.vercel.app/",
  "author": "javiluli",
  "license": "MIT",
  "keywords": [
    "star-rupture",
    "production-planner",
    "gaming-tool",
    "react",
    "typescript",
    "game-assistant",
    "react-flow",
    "supply-chain-calculator",
    "automation-tool"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:skills": "node scripts/validate-skills.mjs",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:all": "node scripts/test-all.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@heroui/react": "^2.8.10",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.10.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
